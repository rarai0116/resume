{
  "plugins": {},
  "filters": {},
  "rules": {
    "preset-ja-technical-writing": {
      "max-kanji-continuous-len": false,
      "ja-no-mixed-period": false,
      "sentence-length": {
        "max": 200
      },
      "no-mix-dearu-desumasu": {
        "preferInHeader": "",
        "preferInBody": "ですます",
        "preferInList": "",
        "strict": false
      }
    },
    "prh": {
      "rulePaths": [
        "./prh.yml"
      ]
    }
  }
}
